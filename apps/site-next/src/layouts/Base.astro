---
import { colourSchemeScript, appShellRootClassFor } from "@hackcove/ui-react";
import { SITE_NAME, SITE_URL } from "#content/site";
import { SCHEMES } from "#content/schemes";
import "#next/styles.css";

interface Props {
  /** The page title. */
  title: string;
}

const { title } = Astro.props;
// The page's own address on the live site, with no trailing slash.
const path =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/(^|\/)index$/, "")
    .replace(/\/+$/, "") || "/";

// colourSchemeScript knows the `dark` class only. The page is built with `latte` on <html>, so once that
// script has decided, this takes `latte` off a dark page: exactly one scope is ever set.
const scopeScript = `${colourSchemeScript};(function(){var r=document.documentElement;r.classList.toggle("${SCHEMES.light}",!r.classList.contains("${SCHEMES.dark}"))})()`;
---

<html lang="en" class={appShellRootClassFor("light", SCHEMES)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{`${title} | ${SITE_NAME}`}</title>
    <link rel="canonical" href={`${SITE_URL}${path}`} />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Before first paint: the visitor's stored choice, else the system's light or dark. No cookie. -->
    <script is:inline set:html={scopeScript} />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
