---
// /developers on the shell, in the suite's section: the page's heading and the story's section for
// developers, then the walkthrough, env, flags, the tools in detail, how to run PixelSlash today and the
// ask. The walkthrough and Today hydrate when they scroll into view, for their copy buttons; Motion
// replays the flags drawing. Nothing else runs in the browser.
import { DEVELOPERS_DESCRIPTION, DEVELOPERS_TITLE } from "#content/site";
import { Ask } from "#next/developers/ask";
import { Env } from "#next/developers/env";
import { Flags } from "#next/developers/flags";
import { Intro } from "#next/developers/intro";
import { Today } from "#next/developers/today";
import { ToolsInDetail } from "#next/developers/tools";
import { Walkthrough } from "#next/developers/walkthrough";
import { Motion } from "#next/illustrations/motion";
import Slash from "#next/layouts/Slash.astro";
---

<Slash section="suite" title={DEVELOPERS_TITLE} description={DEVELOPERS_DESCRIPTION}>
  <Intro />
  <Walkthrough client:visible />
  <Env />
  <Flags />
  <ToolsInDetail />
  <Today client:visible />
  <Ask />
  <Motion client:load />
</Slash>
