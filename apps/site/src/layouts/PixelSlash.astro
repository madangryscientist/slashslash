---
import { appShellRootClassFor, colourSchemeScript } from "@hackcove/ui-react";
import interFont from "@pixelslash-src/apps/site/public/fonts/inter-latin-wght-normal.woff2?url";
import { Shell } from "#ps/components/shell";
import type { SitePath } from "#ps/content/pages";
import { pageHead } from "#ps/content/seo";
import { psAsset } from "#ps/paths";
import { SCHEMES } from "#ps/schemes";
import "#ps/styles.css";

/**
 * The document every /pixelslash page sits in: PixelSlash's own head, stylesheet and shell, nothing of
 * the slashslash Base layout. `path` is the page's path on pixelslash.dev (`/pricing`): the head and
 * the nav read the ported PixelSlash code, which names pages that way.
 */
interface Props {
  path: SitePath;
}

const { path } = Astro.props;
const head = pageHead(path);

// colourSchemeScript knows the `dark` class only. The page is built with `latte` on <html>, so once
// that script has decided, this takes `latte` off a dark page: exactly one scope is ever set.
const scopeScript = `${colourSchemeScript};(function(){var r=document.documentElement;r.classList.toggle("${SCHEMES.light}",!r.classList.contains("${SCHEMES.dark}"))})()`;
---

<html lang="en" class={appShellRootClassFor("light", SCHEMES)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {
      head.meta.map(({ title, name, property, content }) =>
        title !== undefined ? (
          <title>{title}</title>
        ) : name !== undefined ? (
          <meta name={name} content={content} />
        ) : (
          <meta property={property} content={content} />
        ),
      )
    }
    {head.links.map(({ rel, href }) => <link rel={rel} href={href} />)}
    <!-- The one font file, fetched with the HTML rather than after the CSS (PS-307). -->
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href={psAsset("/favicon.svg")} type="image/svg+xml" />
    <!-- Before first paint: the visitor's stored choice, else the system's light or dark. No cookie. -->
    <script is:inline set:html={scopeScript} />
  </head>
  <body class="antialiased">
    <Shell pathname={path}>
      <slot />
    </Shell>
    <script>
      import { markKeyboardScrollers } from "#ps/scripts/keyboard-scrollers";
      import { wireThemeToggle } from "#ps/scripts/theme-toggle";

      wireThemeToggle();
      markKeyboardScrollers();
    </script>
  </body>
</html>
