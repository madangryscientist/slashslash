---
// A tool's home on the shell, in its own section: ToolHome from the tool's data, with its copy
// blocks hydrated when they scroll into view. The hero and the sections set their own width, so it
// sits in the shell's full-width main.
import Slash from "#/layouts/Slash.astro";
import { HeroCode, TryIt } from "#/tools/copy-blocks";
import { ToolHome } from "#/tools/tool-home";
import { heroCommandOf, TOOLS } from "#/tools/tools";

interface Props {
  tool: keyof typeof TOOLS;
}

const tool = TOOLS[Astro.props.tool];
const heroCommand = heroCommandOf(tool);
---

<Slash section={tool.key} title={tool.title.text} description={tool.description.text}>
  <ToolHome tool={tool}>
    {heroCommand !== undefined && <HeroCode slot="heroCode" command={heroCommand} client:visible />}
    <TryIt slot="tryIt" steps={tool.tryIt.steps} client:visible />
  </ToolHome>
</Slash>
