---
// The suite home, on the shell in the suite's section: the hero and the tool cards, then the rest of the
// suite story and the ask. The hero's motion guard runs before first paint; the Motion island and the
// report viewer are the only things on the page that hydrate.
import { HERO } from "#/content/story";
import { Home } from "#/home/home";
import { ReportViewer } from "#/home/report-viewer";
import { Gaps, OneReport, Stands, StepsToday, YourView } from "#/home/sections";
import { Motion, MOTION_SCRIPT } from "#/illustrations/motion";
import Slash from "#/layouts/Slash.astro";
---

<Slash section="suite" title={HERO.title} description={HERO.lead}>
  <script is:inline slot="head" set:html={MOTION_SCRIPT} />
  <Home />
  <StepsToday />
  <Gaps />
  <OneReport />
  <Stands>
    <ReportViewer client:visible />
  </Stands>
  <YourView />
  <Motion client:load />
</Slash>
