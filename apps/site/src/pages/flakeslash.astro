---
import {
  FlakeSlashIntro,
  FlakeSlashLinks,
  FlakeSlashPlanned,
  FlakeSlashToday,
  FlakeSlashTry,
} from "#/components/flakeslash";
import { FLAKESLASH_DESCRIPTION, FLAKESLASH_TITLE } from "#/content/flakeslash";
import Base from "#/layouts/Base.astro";

// /flakeslash: what FlakeSlash is and does today. The docs stay in the FlakeSlash repository.
---

