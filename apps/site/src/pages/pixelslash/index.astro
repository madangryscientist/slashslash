---
// /pixelslash: the PixelSlash home on the shell, in the PixelSlash section. Its hero and its sections
// set their own width, so it sits in the shell's full-width main.
import Slash from "#/layouts/Slash.astro";
import { PixelSlashHome } from "#/pixelslash/pages/home";
import { psPage } from "#/pixelslash/page";

const page = psPage("/");
---

<Slash section="pixelslash" title={page.title} description={page.description}>
  <PixelSlashHome />
</Slash>
