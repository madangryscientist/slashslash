#!/command/with-contenv sh
# The front door. With SLASHSLASH_DOMAIN set, domain.caddy adds a host name per tool on one port.
exec 2>&1
export XDG_DATA_HOME=/data/caddy/data XDG_CONFIG_HOME=/data/caddy/config
mkdir -p /run/caddy
if [ -n "${SLASHSLASH_DOMAIN:-}" ]; then
  cp /etc/caddy/domain.caddy /run/caddy/domain.caddy
else
  : > /run/caddy/domain.caddy
fi
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
